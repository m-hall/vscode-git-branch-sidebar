{
    "name": "vscode-git-branch-sidebar",
    "displayName": "vscode-git-branch-sidebar",
    "description": "Adds a branches section to the source control sidebar for git",
    "version": "1.6.2",
    "publisher": "mia-hall",
    "repository": {
        "type": "git",
        "url": "https://github.com/m-hall/vscode-git-branch-sidebar.git"
    },
    "license": "MIT",
    "engines": {
        "vscode": "^1.67.0"
    },
    "categories": [
        "Other"
    ],
    "extensionDependencies": [
        "vscode.git"
    ],
    "activationEvents": [
        "onView:scm-local-branches",
        "onView:scm-local-stashes",
        "onCommand:scm-local-stashes.scm.stash-staged",
        "onCommand:scm-local-stashes.scm.stash-unstaged",
        "onView:scm-remote-branches"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "configuration": {
            "type": "object",
            "title": "vscode-git-branch-sidebar",
            "properties": {
                "scm-local-branches.showUpstreamStatus": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Show upstream status beside branch name",
                    "scope": "window"
                },
                "scm-local-branches.confirmDelete": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Confirm on delete",
                    "scope": "window"
                },
                "scm-local-branches.renameRespectsPrefix": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Rename will not select the prefix by default when choosing a new name.",
                    "scope": "window"
                },
                "scm-local-branches.stashQuickApply": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "Show a quick access button for applying stashes in the Stashes view.",
                    "scope": "window"
                },
                "scm-local-branches.stashQuickPop": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "Show a quick access button for popping stashes in the Stashes view.",
                    "scope": "window"
                },
                "scm-local-branches.stashQuickDrop": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Show a quick access button for dropping stashes in the Stashes view.",
                    "scope": "window"
                }
            }
        },
        "views": {
            "scm": [
                {
                    "id": "scm-local-branches",
                    "name": "Local Branches",
                    "icon": "images/extension.svg"
                },
                {
                    "id": "scm-remote-branches",
                    "name": "Remote Branches",
                    "icon": "images/extension.svg",
                    "visibility": "collapsed"
                },
                {
                    "id": "scm-local-stashes",
                    "name": "Stashes",
                    "icon": "images/extension.svg",
                    "visibility": "collapsed"
                }
            ]
        },
        "commands": [
            {
                "command": "scm-local-branches.create",
                "title": "Create a new branch from the current commit.",
                "icon": {
                    "dark": "images/dark/add.svg",
                    "light": "images/light/add.svg"
                }
            },
            {
                "command": "scm-local-branches.refresh",
                "title": "Refresh local branch list",
                "icon": {
                    "dark": "images/dark/refresh.svg",
                    "light": "images/light/refresh.svg"
                }
            },
            {
                "command": "scm-local-branches.repo.create-branch",
                "title": "Branch",
                "icon": {
                    "dark": "images/dark/add.svg",
                    "light": "images/light/add.svg"
                }
            },
            {
                "command": "scm-local-branches.branch.delete",
                "title": "Delete",
                "icon": {
                    "dark": "images/dark/close.svg",
                    "light": "images/light/close.svg"
                }
            },
            {
                "command": "scm-local-branches.branch.rename",
                "title": "Rename"
            },
            {
                "command": "scm-local-branches.branch.set-upstream",
                "title": "Set upstream"
            },
            {
                "command": "scm-local-branches.branch.unset-upstream",
                "title": "Unset upstream"
            },
            {
                "command": "scm-local-branches.branch.pull",
                "title": "Pull changes from remote"
            },
            {
                "command": "scm-local-branches.branch.pull-checkout",
                "title": "Pull changes & Checkout"
            },
            {
                "command": "scm-local-stashes.create",
                "title": "Stash changes",
                "icon": {
                    "dark": "images/dark/add.svg",
                    "light": "images/light/add.svg"
                }
            },
            {
                "command": "scm-local-stashes.create-include-untracked",
                "title": "Stash changes (include untracked)"
            },
            {
                "command": "scm-local-stashes.refresh",
                "title": "Refresh stash list",
                "icon": {
                    "dark": "images/dark/refresh.svg",
                    "light": "images/light/refresh.svg"
                }
            },
            {
                "command": "scm-local-stashes.repo.create",
                "title": "Stash changes",
                "icon": {
                    "dark": "images/dark/add.svg",
                    "light": "images/light/add.svg"
                }
            },
            {
                "command": "scm-local-stashes.stash.show",
                "title": "Show changes"
            },
            {
                "command": "scm-local-stashes.stash.apply",
                "title": "Apply",
                "icon": "$(run)"
            },
            {
                "command": "scm-local-stashes.stash.pop",
                "title": "Pop",
                "icon": "$(run-errors)"
            },
            {
                "command": "scm-local-stashes.stash.drop",
                "title": "Drop",
                "icon": {
                    "dark": "images/dark/close.svg",
                    "light": "images/light/close.svg"
                }
            },
            {
                "command": "scm-local-stashes.scm.stash-staged",
                "title": "Stash staged changes",
                "icon": "$(archive)"
            },
            {
                "command": "scm-local-stashes.scm.stash-unstaged",
                "title": "Stash unstaged changes",
                "icon": "$(archive)"
            },
            {
                "command": "scm-remote-branches.refresh",
                "title": "Refresh remote branch list",
                "icon": {
                    "dark": "images/dark/refresh.svg",
                    "light": "images/light/refresh.svg"
                }
            },
            {
                "command": "scm-remote-branches.branch.checkout",
                "title": "Checkout"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "scm-local-branches.create",
                    "when": "view == scm-local-branches && scmLocalBranches:isSingleRepository",
                    "group": "navigation"
                },
                {
                    "command": "scm-local-branches.refresh",
                    "when": "view == scm-local-branches",
                    "group": "navigation"
                },
                {
                    "command": "scm-local-stashes.create",
                    "when": "view == scm-local-stashes && scmLocalBranches:isSingleRepository",
                    "group": "navigation"
                },
                {
                    "command": "scm-local-stashes.refresh",
                    "when": "view == scm-local-stashes",
                    "group": "navigation"
                },
                {
                    "command": "scm-local-stashes.create-include-untracked",
                    "when": "view == scm-local-stashes && scmLocalBranches:isSingleRepository",
                    "group": "stash@1"
                },
                {
                    "command": "scm-remote-branches.refresh",
                    "when": "view == scm-remote-branches",
                    "group": "navigation"
                }
            ],
            "view/item/context": [
                {
                    "command": "scm-local-branches.repo.create-branch",
                    "when": "view == scm-local-branches && viewItem == repo",
                    "group": "inline"
                },
                {
                    "command": "scm-local-branches.branch.delete",
                    "when": "view == scm-local-branches && (viewItem == branch || viewItem == branchWithUpstream)",
                    "group": "inline"
                },
                {
                    "command": "scm-local-branches.branch.rename",
                    "when": "view == scm-local-branches && viewItem != repo",
                    "group": "branchActions@1"
                },
                {
                    "command": "scm-local-branches.branch.delete",
                    "when": "view == scm-local-branches && (viewItem == branch || viewItem == branchWithUpstream)",
                    "group": "branchActions@2"
                },
                {
                    "command": "scm-local-branches.branch.set-upstream",
                    "when": "view == scm-local-branches && viewItem != repo",
                    "group": "upstreams@1"
                },
                {
                    "command": "scm-local-branches.branch.unset-upstream",
                    "when": "view == scm-local-branches && (viewItem == branchWithUpstream || viewItem == activeBranchWithUpstream)",
                    "group": "upstreams@2"
                },
                {
                    "command": "scm-local-branches.branch.pull",
                    "when": "view == scm-local-branches && (viewItem == branchWithUpstream || viewItem == activeBranchWithUpstream)",
                    "group": "upstreams@3"
                },
                {
                    "command": "scm-local-branches.branch.pull-checkout",
                    "when": "view == scm-local-branches && viewItem == branchWithUpstream",
                    "group": "upstreams@4"
                },
                {
                    "command": "scm-local-stashes.repo.create",
                    "when": "view == scm-local-stashes && viewItem == repo",
                    "group": "inline"
                },
                {
                    "command": "scm-local-stashes.stash.show",
                    "when": "view == scm-local-stashes && viewItem == stash",
                    "group": "stashActions@1"
                },
                {
                    "command": "scm-local-stashes.stash.apply",
                    "when": "view == scm-local-stashes && viewItem == stash",
                    "group": "stashActions@2"
                },
                {
                    "command": "scm-local-stashes.stash.pop",
                    "when": "view == scm-local-stashes && viewItem == stash",
                    "group": "stashActions@3"
                },
                {
                    "command": "scm-local-stashes.stash.drop",
                    "when": "view == scm-local-stashes && viewItem == stash",
                    "group": "stashActions@4"
                },
                {
                    "command": "scm-local-stashes.stash.apply",
                    "when": "view == scm-local-stashes && viewItem == stash && config.scm-local-branches.stashQuickApply",
                    "group": "inline@1"
                },
                {
                    "command": "scm-local-stashes.stash.pop",
                    "when": "view == scm-local-stashes && viewItem == stash && config.scm-local-branches.stashQuickPop",
                    "group": "inline@2"
                },
                {
                    "command": "scm-local-stashes.stash.drop",
                    "when": "view == scm-local-stashes && viewItem == stash && config.scm-local-branches.stashQuickDrop",
                    "group": "inline@3"
                },
                {
                    "command": "scm-remote-branches.branch.checkout",
                    "when": "view == scm-remote-branches && viewItem == remoteBranch",
                    "group": "branchActions@1"
                }
            ],
            "scm/resourceGroup/context": [
                {
                    "command": "scm-local-stashes.scm.stash-staged",
                    "when": "scmProvider == git && scmResourceGroup == index",
                    "group": "inline"
                },
                {
                    "command": "scm-local-stashes.scm.stash-unstaged",
                    "when": "scmProvider == git && scmResourceGroup == workingTree",
                    "group": "inline"
                },
                {
                    "command": "scm-local-stashes.scm.stash-staged",
                    "when": "scmProvider == git && scmResourceGroup == index",
                    "group": "stash@1"
                },
                {
                    "command": "scm-local-stashes.scm.stash-unstaged",
                    "when": "scmProvider == git && scmResourceGroup == workingTree",
                    "group": "stash@1"
                }
            ],
            "commandPalette": [
                {
                    "command": "scm-local-stashes.scm.stash-staged",
                    "when": "scmLocalBranches:isSingleRepository"
                },
                {
                    "command": "scm-local-stashes.scm.stash-unstaged",
                    "when": "scmLocalBranches:isSingleRepository"
                },
                {
                    "command": "scm-remote-branches.branch.checkout",
                    "when": "false"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/glob": "^7.1.1",
        "@types/mocha": "^5.2.6",
        "@types/node": "^10.17.19",
        "@types/vscode": "^1.67.0",
        "eslint": "^8.17.0",
        "glob": "^7.1.6",
        "mocha": "^12.0.2",
        "typescript": "^3.8.3",
        "vscode-test": "^1.3.0"
    }
}
